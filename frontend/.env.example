# Where to fetch a LiveKit room-join token from. Vite bakes this in at build
# time, so it's picked from .env.production or .env.development depending on
# `npm run build` vs `npm run dev` -- this file is just for reference.
VITE_TOKEN_ENDPOINT=https://your-api-project.vercel.app/api/livekit_token

# Where the hidden debug panel checks live STT/TTS provider health before a
# call. Same origin as VITE_TOKEN_ENDPOINT, different path.
VITE_STATUS_ENDPOINT=https://your-api-project.vercel.app/api/provider_status
