# --- LiveKit ---
# From your LiveKit Cloud project (cloud.livekit.io) or self-hosted server config.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Gemini (speech-to-speech via the Live API: STT + LLM + TTS in one) ---
# From Google AI Studio: https://aistudio.google.com/apikey
# A Google Cloud service account is NOT needed -- agent.py uses the Gemini
# Live API exclusively, authenticated with just this key. (An earlier
# version of this project used Cloud Speech-to-Text + Cloud Text-to-Speech,
# which needed a service account -- dropped after live testing found Cloud
# TTS has zero Sinhala voices at all. See README "Known risks".)
GOOGLE_API_KEY=

# --- Token server (used by the web client to join the LiveKit room) ---
TOKEN_SERVER_PORT=8080
