# --- LiveKit ---
# From your LiveKit Cloud project (cloud.livekit.io) or self-hosted server config.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Azure Speech (STT, si-LK) ---
# From the Azure Portal: create a "Speech" resource, then Keys and Endpoint.
AZURE_API_KEY=
AZURE_REGION=

# --- Gemini (LLM + TTS) ---
# From Google AI Studio: https://aistudio.google.com/apikey
# No Google Cloud service account needed -- both google.LLM (plain text) and
# GeminiTTS (livekit.plugins.google.beta) work with just this API key.
GOOGLE_API_KEY=

# --- Token server (used by the web client to join the LiveKit room) ---
TOKEN_SERVER_PORT=8080
