# --- LiveKit ---
# From your LiveKit Cloud project (cloud.livekit.io) or self-hosted server config.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Azure Speech (STT, si-LK) ---
# From the Azure Portal: create a "Speech" resource, then Keys and Endpoint.
# This is the default STT provider -- see STT_PROVIDER below for the option
# to switch to Google's Chirp model instead.
AZURE_API_KEY=
AZURE_REGION=

# --- Gemini (LLM + TTS) ---
# From Google AI Studio: https://aistudio.google.com/apikey
# No Google Cloud service account needed -- both google.LLM (plain text) and
# GeminiTTS (livekit.plugins.google.beta) work with just this API key.
GOOGLE_API_KEY=

# --- STT provider toggle (optional) ---
# Leave unset (or "azure") to use Azure Speech above. Set to "chirp" (or
# "google") to use Google Cloud Speech-to-Text's chirp_2 model instead --
# needs GOOGLE_SERVICE_ACCOUNT_JSON below (a real Cloud service account,
# unlike GOOGLE_API_KEY above -- Cloud Speech-to-Text doesn't support
# plain API-key auth the way Gemini does).
STT_PROVIDER=azure

# The full JSON content of a Google Cloud service account key, as a single
# line (not a file path) -- only needed if STT_PROVIDER=chirp. Get one from
# Google Cloud Console: IAM & Admin -> Service Accounts -> Create -> grant
# it Cloud Speech access -> Keys -> Add Key -> JSON, then compact it to one
# line, e.g.: python -c "import json;print(json.dumps(json.load(open('key.json'))))"
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Token server (used by the web client to join the LiveKit room) ---
TOKEN_SERVER_PORT=8080
