# These are only needed for the LiveKit agent worker, which does NOT run on
# Vercel (see README) — keep them out of the Vercel deployment entirely so
# their presence can't affect what Vercel bundles/builds for api/.
agent.py
requirements.lock
db.py
tools.py
seed.py
token_server.py
hospital.db
.venv/
__pycache__/
Dockerfile
.dockerignore
livekit.toml

# The React frontend (frontend/) deploys as its own separate Vercel project
# (root directory set to frontend/ there) -- keep its node_modules/ especially
# out of this project's build entirely.
frontend/
